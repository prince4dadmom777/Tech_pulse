{
  "name": "flowpilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "FlowPilot AI - Autonomous Business Workflow Manager",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:api": "npm run dev:backend",
    "dev:web": "npm run dev:frontend",
    "build": "npm run build --workspace=@flowpilot/shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
